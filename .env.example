# ─────────────────────────────────────────────────────────────
#  LogicKids — Next.js Fullstack
#  Copie para .env.local e preencha os valores
# ─────────────────────────────────────────────────────────────

# ── Supabase PostgreSQL ──────────────────────────────────────
# Crie um projeto em https://supabase.com/dashboard
# Em Project Settings → Database → Connection string, copie:
# DATABASE_URL: Pooler (Transaction), com ?pgbouncer=true
# DIRECT_URL: conexão direta ou Pooler (Session), para migrations
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[DB-HOST]:5432/postgres"

# ── JWT (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ──
JWT_SECRET="cole-aqui-uma-string-longa-e-aleatoria"

# ── Google Gemini (gratuito) ──────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# ── Hugging Face / Missão Clima ──────────────────────────────
# Token opcional: sem ele, a aplicação usa o banco local de fallback
HF_TOKEN="hf_..."
# Modelo padrão: Qwen/Qwen2.5-72B-Instruct
# Alternativa: meta-llama/Llama-3.1-8B-Instruct
HF_MODEL="Qwen/Qwen2.5-72B-Instruct"

# ── Next.js ───────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
